# 数据库 —— 路径相对于 prisma/ 目录（Prisma schema 所在处）。
#
# dev 与 prod 都放在 instance/database/ 下，instance/ 是**唯一的数据目录**——
# 头像 / 图床 / 故事 / 数据库都归这里，部署时挂一个目录。
#
# dev 用 ./instance/database/dev.db（gitignored），prod 用绝对路径。
# 想对真实库做事，临时覆盖 DATABASE_URL。
DATABASE_URL="file:../instance/database/dev.db"

# 会话签名密钥。签 JWT 用，另外（沿用历史）也是**回调签名密钥**加密密钥的派生源
# —— 见下方 FISH_ENCRYPTION_KEY 的说明。
SECRET_KEY="改成生产正在用的长随机串"

# 回调签名密钥的加密密钥。
#
# ⚠️ 首次部署既有数据库时：**留空**。
#
# 历史上该密钥**只**从 SECRET_KEY 派生（Fernet 套件）：
#   Fernet(base64.urlsafe_b64encode(sha256(SECRET_KEY)))
# 库里 fish_webhook_endpoints.secret_encrypted 的存量密文都是用 SECRET_KEY 加密的。
# 这里一旦填了非空值，Next 改用它派生密钥，存量密文立刻解不开
# （报 Invalid Token: HMAC），**商户再也收不到回调**，且不可逆。
#
# 留空 = 回退 SECRET_KEY = 与历史一致 = 存量密文正常解开。
# 仅在全新部署、库里没有任何存量密文时，才考虑设独立密钥。
FISH_ENCRYPTION_KEY=""

# 鱼干「服务账号」白名单：逗号分隔的 **user id**（不是用户名）。
#
# 名单里的账号转账配额从 30 次/时、200 次/天 提到 500/5000 —— 给站外银行、
# 记账机器人这类自动化账号用（见 docs/bot/fish-bot.md §4）。留空 = 没有服务账号。
#
# ⚠️ 白名单同时也拿掉了那个账号的反滥用闸门（它能把鱼干推给任意第三方），
#    所以只给真正需要的账号开；撤销 = 删掉这一行 + 重启。
FISH_SERVICE_ACCOUNTS=""

# 魔杖 demo 实时 WebSocket 地址（默认 ws://localhost:3033，即原站硬编码地址）
NEXT_PUBLIC_WAND_WS_URL="ws://localhost:3033"

# 图床存储目录（缺省为 ./instance/images）
IMAGE_UPLOAD_FOLDER=""

# Cloudflare Turnstile（注册页人机验证；未启用则跳过）
TURNSTILE_AVAILABLE="False"
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_AVAILABLE="False"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# 小鱼干账户曾经在站外一个独立的 FastAPI 微服务里，靠 ACCOUNT_SERVICE_* 四件套连接。
# 那套东西已搬进站内（账目与业务数据同一个 SQLite 文件、同一个事务），
# 这几个变量**不再被任何代码读取** —— 留着它们不会有任何效果，删掉即可。

# 鱼干练手盘的行情源（/fish/trade）。
#
# 默认 data-api.binance.vision —— 币安拆出来的纯行情公共域，不吃 key。开发机上留空
# 即可（能直连）。线上**必须**先在这台服务器上跑一次
#   curl -s -m 8 -o /dev/null -w "%{http_code}\n" "https://data-api.binance.vision/api/v3/time"
# 返回 200 才继续 —— 生产是阿里云大陆，出口策略与家宽不同，详见
# .env.production.example 里这同一段的长注释。换源改这一个变量即可。
MARKET_PRICE_BASE_URL=""

# 练手盘行情的刷新间隔（毫秒）。留空 = 15000；置 0 = 关闭。
# **只影响展示**，不影响成交价（成交价下单那一刻现取）。vitest 与 e2e 都会置 0。
MARKET_POLL_MS=""

# 练手盘的**实时行情流**（常驻 WebSocket，订币安 @trade）的半死阈值（毫秒）：
# 合计这么久收不到任何一帧就强制重连。留空 = 30000；置 0 = **关闭整条流**
# （展示回落到上面那条 15 秒轮询，功能照常，只是价跳得慢）。
# 需要 Node 22+（全局 WebSocket）；Node 20 上会打一行日志后自动退化。
# **同样只喂展示**，成交价照旧下单那一刻现取。vitest 与 e2e 都会置 0。
MARKET_STREAM_SILENCE_MS=""

# ── 反向代理相关（套 nginx 时必配，否则会翻车）───────────────────────────────

# CSRF 白名单：允许发起写请求的站点来源，逗号分隔。
# 中间件拿浏览器的 Origin 跟它比对；对不上就当 CSRF 拒掉（403）。
# 套了 nginx 之后 Host 是 127.0.0.1:3000，与 Origin 对不上，所以必须显式配这个
# （或让 nginx 转发 X-Forwarded-Host，中间件会认）。
ALLOWED_ORIGINS="https://raricy.com"

# 站点对外地址 —— **所有绝对 URL 的唯一来源**：
#   · OAuth 2.0 issuer（userinfo 的 avatar_url）
#   · 画报 / 收款码 / 文章分享卡片里二维码与 OG 图的绝对地址
#   · sitemap.xml / robots.txt，以及 Next 的 metadataBase
# 未配置时从 ALLOWED_ORIGINS 第一项兜底，并打 console.warn；
# 两者都空时：画报路由直接 503（宁可不出图，也不给一张扫不开的废码），
# 而 sitemap/metadataBase 兜底到正式域名（见 src/lib/site-url.ts 的 siteBaseUrl）。
# ⚠️ 别再新增 NEXT_PUBLIC_SITE_URL —— 那会凭空多出第二个真相源。
SITE_URL="https://raricy.com"

# 会话 cookie 是否加 Secure 标记。留空则自动判断：
#   X-Forwarded-Proto（nginx 转发的）> NODE_ENV。
# 配错的典型症状：登录接口返回成功，但刷新后仍是未登录 —— 因为 cookie 被浏览器丢了。
# 走 HTTPS 就设 true；纯 HTTP 内网调试设 false。
COOKIE_SECURE=""
