// ─────────────────────────────────────────────────────────────────────────────
// raricy.com — Prisma schema (规范 / 目标态)
//
// 从既有的 SQLAlchemy 库 1:1 映射而来。字段用 camelCase，通过 @map/@@map
// 对齐真实 snake_case 表/列名，**不改动数据结构**。
//
// ⚠️ 关键：DateTime 格式
//   SQLAlchemy 以 "YYYY-MM-DD HH:MM:SS.ffffff"（空格分隔、无时区）写入；
//   Prisma 的 SQLite 连接器按列的“声明类型 DATETIME”在驱动层解析，这种格式会直接报
//   "Conversion failed: input contains invalid characters"（已实测复现）。
//   因此使用本 schema 前，数据库必须先规整为 **INTEGER（Unix 毫秒）** —— 与 Prisma
//   自己写入 SQLite 的存储格式一致：
//       npm run db:normalize            # 在副本上执行，见 scripts/normalize-datetimes.mjs
//   （曾经转成 ISO 文本：Prisma 读得出，但 SQLite 跨存储类型比较按类型序而非数值，
//     会让 gte 恒真 / lt 恒假 —— 表现为历史文章全被算成「今天发的」。）
//   规整是单向门：TEXT 一旦转成 INTEGER 就回不去了；此后仍按旧文本格式读这个库的读取方
//   需自行适配，否则只能按“硬切换”处理。
//
// 其它：
//   • admin_action_logs.extra 是 JSON 列，SQLite 上 Prisma 无 Json 标量 → 映射 String，
//     应用层自行 JSON.parse/stringify。
//   • 本库 schema 由本仓 scripts/migrate.mjs + _raricy_migrations 跟踪表管理，
//     **不要**对本库跑 prisma migrate —— 它不认识 0_init 基线（0_init 是从历史库
//     反向生成的建表 SQL），会把它当作未应用而重放，在第一条 CREATE TABLE 上
//     冲突失败。
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── 用户与权限 ───────────────────────────────────────────────────────────────

model User {
  id             String    @id
  username       String    @unique(map: "ix_users_username")
  email          String    @unique(map: "ix_users_email")
  passwordHash   String    @map("password_hash")
  createdAt      DateTime? @map("created_at")
  lastLogin      DateTime? @map("last_login")
  avatarPath     String?   @map("avatar_path")
  bio            String?
  sessionVersion Int       @default(0) @map("session_version")

  notifyLike   Boolean? @default(true) @map("notify_like")
  notifyEdit   Boolean? @default(true) @map("notify_edit")
  notifyDelete Boolean? @default(true) @map("notify_delete")
  notifyAdmin  Boolean? @default(true) @map("notify_admin")

  showRecentBlogs    Boolean @default(true) @map("show_recent_blogs")
  showRecentComments Boolean @default(true) @map("show_recent_comments")

  // 专注模式：账号级浏览偏好（默认关）。开启后博客列表/侧栏隐藏 focusHidden 栏目，
  // 讨论大区与「玩具」入口禁用。登出/游客不生效（见 docs/architecture.md 偏好约定）。
  focusMode Boolean @default(false) @map("focus_mode")

  isBanned  Boolean?  @default(false) @map("is_banned")
  banUntil  DateTime? @map("ban_until")
  banReason String?   @map("ban_reason")

  role String @default("user")

  totalFortune Int @default(0) @map("total_fortune")
  // ⚠️ 存储单位 = 0.0001 鱼干（整数）。原为 Float，已整数化防 IEEE754 账目漂移；
  // 粒度由 3_fish_integer_units（×10，0.1 鱼干）经 21_fish_units_1e4（×1000）抬到现在。
  // 换算见 src/lib/fish-units.ts（那是活的权威）。
  // SQLite 列仍是 REAL 亲和（动态类型，整数值无损存取；db pull 会显示 Float，以此注释为准）。
  driedFish Int @default(0) @map("dried_fish")

  fishApiKeyEncrypted String? @map("fish_api_key_encrypted")

  /// 当前装备的头像框 key。**冗余列** —— 权威持有关系在 user_frames。
  /// 唯一写入者是 src/lib/frame-service.ts 的 grantFrame / revokeFrame / equipFrame
  /// （见该文件头部的不变量 F1/F2）。**别在渲染点直接读它** —— 渲染一律走
  /// frameUrlFor()，那里才有到期判定（tests/unit/frame-guard.test.ts 静态拦着）。
  equippedFrameKey       String?   @map("equipped_frame_key")
  /// 装备那一刻该框的到期时刻（NULL = 永久）。同样是冗余列。
  /// 到期是**只读判定**：过期的值留在列里无害（判定恒 null），故无定时清理。
  equippedFrameExpiresAt DateTime? @map("equipped_frame_expires_at")

  blogs                 Blog[]              @relation("BlogAuthor")
  blogLikes             BlogLike[]
  favorites             Favorite[]
  comments              BlogComment[]       @relation("CommentAuthor")
  commentLikes          CommentLike[]
  notificationsReceived Notification[]      @relation("NotificationRecipient")
  notificationsSent     Notification[]      @relation("NotificationActor")
  clipboards            ClipBoard[]
  images                ImageHosting[]
  audio                 AudioHosting[]
  votes                 Vote[]
  voteRecords           VoteRecord[]
  checkins              DailyCheckIn[]
  fishTransactions      FishTransaction[]   @relation("FishTxUser")
  fishTransactionsPeer  FishTransaction[]   @relation("FishTxRelated")
  blogFeeds             BlogFeed[]
  adminActionsPerformed AdminActionLog[]    @relation("LogAdmin")
  adminActionsReceived  AdminActionLog[]    @relation("LogTarget")
  appeals               AdminActionAppeal[] @relation("AppealAppellant")
  appealsDecided        AdminActionAppeal[] @relation("AppealDecider")
  invitesUsed           InviteCode[]
  bansReceived          UserBan[]           @relation("BanUser")
  bansIssued            UserBan[]           @relation("BanAdmin")
  bansLifted            UserBan[]           @relation("BanLifter")
  oauthAppsCreated      OAuthApplication[]      @relation("OAuthAppOwner")
  oauthCodes            OAuthAuthorizationCode[]
  oauthTokens           OAuthAccessToken[]
  chatMembers           ChatMember[]            @relation("ChatMemberUser")
  chatMessages          ChatMessage[]           @relation("ChatMessageAuthor")
  fishApiTokens         FishApiToken[]
  fishWebhookEndpoint   FishWebhookEndpoint?
  fishWebhookDeliveries FishWebhookDelivery[]
  marketPositions       MarketPosition[]
  frames                UserFrame[]
  visibilityLogs        BlogVisibilityLog[]  @relation("BlogVisibilityLogActor")
  @@index([id], map: "ix_users_id")
  @@index([role], map: "ix_users_role")

  @@map("users")
}

/// 文章可见性变更记录。
///
/// 【为什么值得一张表】`public` 是**不可逆**的（搜索引擎与第三方存档会抓走副本），
/// 而在此之前「作者把自己的文章放出去」**不留任何痕迹**：那条进通知的 changesDetail
/// 只在「管理员编辑他人文章」时才发，而 PUT / PATCH 都只认作者本人，所以那条路径对
/// 可见性根本不可达。不可逆的动作该有账。
///
/// 【只记变更，不记创建】新文章落 `internal` 是默认档、不是「变更」—— 记它等于给每次
/// 发文都写一行噪音。所以这张表回答的是「改过几次、什么时候」，不是「前世今生」。
/// （存量文章在改名迁移 17 之前也没有行，同理。）
model BlogVisibilityLog {
  id        Int      @id @default(autoincrement())
  blogId    String   @map("blog_id")
  /// 改的人。**今天恒等于作者**（PUT / PATCH 都只认作者本人），但账不该依赖
  /// 「将来也不会有人代改」这个假设 —— 假设一旦破，历史补不回来。
  actorId   String   @map("actor_id")
  fromValue String   @map("from_value")
  toValue   String   @map("to_value")
  createdAt DateTime @map("created_at")

  blog  Blog @relation("BlogVisibilityLogBlog", fields: [blogId], references: [id])
  actor User @relation("BlogVisibilityLogActor", fields: [actorId], references: [id])

  @@index([blogId, createdAt], map: "ix_blog_visibility_logs_blog")
  @@map("blog_visibility_logs")
}

model InviteCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  isUsed    Boolean?  @default(false) @map("is_used")
  createdAt DateTime? @map("created_at")
  usedBy    String?   @map("used_by")

  usedByUser User? @relation(fields: [usedBy], references: [id])

  @@map("invite_codes")
}

model UserBan {
  id       Int       @id @default(autoincrement())
  userId   String    @map("user_id")
  adminId  String    @map("admin_id")
  bannedAt DateTime  @map("banned_at")
  banUntil DateTime  @map("ban_until")
  reason   String
  isLifted Boolean?  @default(false) @map("is_lifted")
  liftedAt DateTime? @map("lifted_at")
  liftedBy String?   @map("lifted_by")

  user   User  @relation("BanUser", fields: [userId], references: [id])
  admin  User  @relation("BanAdmin", fields: [adminId], references: [id])
  lifter User? @relation("BanLifter", fields: [liftedBy], references: [id])
  @@index([adminId], map: "ix_user_bans_admin_id")
  @@index([userId], map: "ix_user_bans_user_id")

  @@map("user_bans")
}

// ── 博客 ─────────────────────────────────────────────────────────────────────

model Blog {
  id            String    @id
  title         String
  description   String    @default("")
  authorId      String    @map("author_id")
  createdAt     DateTime? @map("created_at")
  ignore        Boolean?  @default(false)
  likesCount    Int?      @default(0) @map("likes_count")
  // ⚠️ 与上面那些「存储单位 = 0.0001 鱼干」的列**不同**：这列是**鱼干**口径的整数（投喂累加），
  // 未经 Float 时代，也未被 3_fish_integer_units / 21_fish_units_1e4 触碰，
  // **不参与 fish-units 换算**。feedBlog 只收 1~5 的整数，所以喂进来的恒是整数。别顺手统一。
  fishCount     Int       @default(0) @map("fish_count")
  commentsCount Int?      @default(0) @map("comments_count")
  lastCommentAt DateTime? @map("last_comment_at")
  categoryId    Int?      @map("category_id")
  isFeatured    Boolean?  @default(false) @map("is_featured")
  // 对外可见性三档：'internal'（仅站内 core+ —— 也就是本站一直以来的样子）/
  // 'link'（拿到链接的任何人可读，不列举、不索引）/ 'public'（可列举、可索引）。
  // 取值白名单在 src/lib/blog-visibility.ts（BLOG_VISIBILITIES + parseVisibility）：
  // SQLite 没有 enum，Prisma 在 sqlite provider 上也不支持 enum，所以这里只能存
  // String，校验全在 TS 那一层（写入只有一个入口 validateBlogData）。
  // 那个模块是零依赖的 —— 发文表单是客户端组件，而 blog-service 拖着 prisma 进不去。
  // ⚠️ 这一列只对**非 core 的查看者**生效：core+ 在博客域是全读的，他们不看这个值。
  //
  // 【第一档原来叫 private，2026-09 改成 internal（迁移 17）】'private' 在本仓库
  // 已经是「只有本人」的意思（剪贴板的 publicity、收藏夹的 public_id 恒 NULL），
  // 而这一档是**所有 core+ 成员都能看** —— 撞名会让人把它读成「作者私藏」。
  // ⚠️ 生产库那份列默认值仍是旧的 'private'（SQLite 改不了列默认值，除非重建表；
  // 而没有任何生产路径依赖它 —— createBlog 显式写这一列）。**别去「修复」它**，
  // 见迁移 17 的头部注释。
  visibility    String    @default("internal")

  author   User          @relation("BlogAuthor", fields: [authorId], references: [id])
  category Category?     @relation(fields: [categoryId], references: [id])
  content  BlogContent?
  likes    BlogLike[]
  visibilityLogs BlogVisibilityLog[] @relation("BlogVisibilityLogBlog")
  comments BlogComment[]
  feeds    BlogFeed[]
  favoriteItems FavoriteItem[]
  @@index([id], map: "ix_blogs_id")
  @@index([title], map: "ix_blogs_title")
  @@index([authorId], map: "ix_blogs_author_id")
  @@index([categoryId], map: "ix_blogs_category_id")
  @@index([isFeatured], map: "ix_blogs_is_featured")
  @@index([lastCommentAt], map: "ix_blogs_last_comment_at")
  @@index([ignore], map: "ix_blogs_ignore")
  @@index([createdAt], map: "ix_blogs_created_at")
  @@index([visibility], map: "ix_blogs_visibility")

  @@map("blogs")
}

model BlogContent {
  blogId    String    @id @map("blog_id")
  content   String
  updatedAt DateTime? @map("updated_at")

  blog Blog @relation(fields: [blogId], references: [id])

  @@map("blog_contents")
}

model BlogLike {
  id               Int       @id @default(autoincrement())
  blogId           String    @map("blog_id")
  userId           String    @map("user_id")
  createdAt        DateTime? @map("created_at")
  notificationSent Boolean   @default(false) @map("notification_sent")
  deleted          Boolean   @default(false)
  deletedAt        DateTime? @map("deleted_at")

  blog Blog @relation(fields: [blogId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([blogId, userId], name: "uq_blog_like_blog_user")
  @@index([blogId], map: "ix_blog_likes_blog_id")
  @@index([userId], map: "ix_blog_likes_user_id")
  @@map("blog_likes")
}

model BlogFeed {
  id        Int       @id @default(autoincrement())
  blogId    String    @map("blog_id")
  userId    String    @map("user_id")
  // ⚠️ 存储单位 = 0.0001 鱼干（整数），原 Float 已整数化，见 User.driedFish 注释；
  // 换算见 src/lib/fish-units.ts。
  // 业务上限 5 鱼干 = 50 单位。
  amount    Int       @default(0)
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  blog Blog @relation(fields: [blogId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([blogId, userId], name: "uq_blog_feed_user")
  @@index([blogId], map: "ix_blog_feeds_blog_id")
  @@index([userId], map: "ix_blog_feeds_user_id")
  @@map("blog_feeds")
}

// ── 分类 ─────────────────────────────────────────────────────────────────────

model Category {
  id                Int       @id @default(autoincrement())
  name              String
  slug              String    @unique(map: "ix_categories_slug")
  description       String?   @default("")
  parentId          Int?      @map("parent_id")
  sortOrder         Int?      @default(0) @map("sort_order")
  isActive          Boolean?  @default(true) @map("is_active")
  icon              String?   @default("")
  createdAt         DateTime? @map("created_at")
  excludeFromAll    Boolean?  @default(false) @map("exclude_from_all")
  adminOnlyPosting  Boolean?  @default(false) @map("admin_only_posting")
  notifyAdminOnPost Boolean?  @default(false) @map("notify_admin_on_post")
  // 专注模式隐藏：站长在栏目管理勾选；勾选根栏目时子栏目一并（由 listBlogs 子树展开）。
  // 与 excludeFromAll 区别：这是「对开启专注模式的用户个人生效」，exclude 是全站生效。
  focusHidden Boolean? @default(false) @map("focus_hidden")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  blogs    Blog[]
  @@index([notifyAdminOnPost], map: "ix_categories_notify_admin_on_post")
  @@index([adminOnlyPosting], map: "ix_categories_admin_only_posting")
  @@index([sortOrder], map: "ix_categories_sort_order")
  @@index([isActive], map: "ix_categories_is_active")
  @@index([name], map: "ix_categories_name")
  @@index([parentId], map: "ix_categories_parent_id")
  @@index([excludeFromAll], map: "ix_categories_exclude_from_all")
  @@index([focusHidden], map: "ix_categories_focus_hidden")

  @@map("categories")
}

// ── 评论 ─────────────────────────────────────────────────────────────────────

model BlogComment {
  id          String    @id
  blogId      String    @map("blog_id")
  authorId    String    @map("author_id")
  parentId    String?   @map("parent_id")
  rootId      String?   @map("root_id")
  content     String
  contentHtml String?   @map("content_html")
  // 引用的图床图片（上传走 /api/images，评论只存引用）。无 relation —— 与
  // ChatMessage.imageId 同策略：图床清理不该被历史评论挡住，读时解析、缺了给占位。
  imageId     String?   @map("image_id")
  // 引用的博客（被评论的那篇之外的另一篇）。⚠️ 叫 quote_blog_id 而不是 blog_id ——
  // 上面的 blogId 已被「评论所属文章」占用（带外键关系），两个语义不能同名。
  // 同 imageId 策略：不加外键、博客软删不挡评论，读时按当前 Blog 行解析。
  quoteBlogId String?   @map("quote_blog_id")
  status      String?   @default("approved")
  isDeleted   Boolean?  @default(false) @map("is_deleted")
  likesCount  Int?      @default(0) @map("likes_count")
  createdAt   DateTime? @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  blog        Blog          @relation(fields: [blogId], references: [id])
  author      User          @relation("CommentAuthor", fields: [authorId], references: [id])
  parent      BlogComment?  @relation("CommentParent", fields: [parentId], references: [id])
  children    BlogComment[] @relation("CommentParent")
  root        BlogComment?  @relation("CommentRoot", fields: [rootId], references: [id])
  descendants BlogComment[] @relation("CommentRoot")
  likes       CommentLike[]
  @@index([authorId], map: "ix_blog_comments_author_id")
  @@index([blogId], map: "ix_blog_comments_blog_id")
  @@index([createdAt], map: "ix_blog_comments_created_at")
  @@index([isDeleted], map: "ix_blog_comments_is_deleted")
  @@index([parentId], map: "ix_blog_comments_parent_id")
  @@index([rootId], map: "ix_blog_comments_root_id")
  @@index([status], map: "ix_blog_comments_status")

  @@map("blog_comments")
}

model CommentLike {
  id        Int       @id @default(autoincrement())
  commentId String    @map("comment_id")
  userId    String    @map("user_id")
  createdAt DateTime? @map("created_at")

  comment BlogComment @relation(fields: [commentId], references: [id])
  user    User        @relation(fields: [userId], references: [id])

  @@unique([commentId, userId], name: "uq_comment_like_comment_user")
  @@index([commentId], map: "ix_comment_likes_comment_id")
  @@index([userId], map: "ix_comment_likes_user_id")
  @@map("comment_likes")
}

// ── 通知 ─────────────────────────────────────────────────────────────────────

model Notification {
  id          String    @id
  timestamp   DateTime? @map("timestamp")
  action      String
  recipientId String    @map("recipient_id")
  actorId     String?   @map("actor_id")
  objectType  String?   @map("object_type")
  objectId    String?   @map("object_id")
  detail      String?
  read        Boolean   @default(false)

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id])
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id])
  @@index([timestamp], map: "ix_notifications_timestamp")

  @@map("notifications")
}

// ── 剪贴板 ───────────────────────────────────────────────────────────────────

model ClipBoard {
  id        String    @id
  title     String
  authorId  String    @map("author_id")
  createdAt DateTime? @map("created_at")
  ignore    Boolean?  @default(false)
  publicity Boolean?  @default(true)

  author  User      @relation(fields: [authorId], references: [id])
  content ClipText?
  @@index([authorId], map: "ix_clipboards_author_id")
  @@index([createdAt], map: "ix_clipboards_created_at")
  @@index([id], map: "ix_clipboards_id")
  @@index([ignore], map: "ix_clipboards_ignore")
  @@index([publicity], map: "ix_clipboards_publicity")
  @@index([title], map: "ix_clipboards_title")

  @@map("clipboards")
}

model ClipText {
  clipId    String    @id @map("clip_id")
  content   String
  updatedAt DateTime? @map("updated_at")

  clipboard ClipBoard @relation(fields: [clipId], references: [id])

  @@map("clip_text")
}

// ── 图床 ─────────────────────────────────────────────────────────────────────

model ImageHosting {
  id        String    @id
  filename  String
  fileSize  Int       @map("file_size")
  mimeType  String    @map("mime_type")
  authorId  String    @map("author_id")
  createdAt DateTime? @map("created_at")
  isPublic  Boolean?  @default(true) @map("is_public")
  ignore    Boolean?  @default(false)

  author    User            @relation(fields: [authorId], references: [id])
  chatMessages ChatMessage[]
  @@index([authorId], map: "ix_image_hosting_author_id")
  @@index([createdAt], map: "ix_image_hosting_created_at")
  @@index([id], map: "ix_image_hosting_id")
  @@index([ignore], map: "ix_image_hosting_ignore")

  @@map("image_hosting")
}

// ── 音频床 ───────────────────────────────────────────────────────────────────
//
// 与 ImageHosting 逐字段同构（见 src/lib/audio-upload.ts 头部）。两处**刻意**的差别：
//   · 没有 `chatMessages` 反向关系 —— 音频不开「附件」那条链路（附件是 image_id 列，
//     不是托管域；见 src/lib/audio-service.ts 头部）。
//   · 配额**独立计量**（50MB 归音频自己），但**限额复用同一张表**
//     （image-upload.ts 的 QUOTA_LIMITS_MB）—— 避免出现第二份配额权威。
model AudioHosting {
  id        String    @id
  filename  String
  fileSize  Int       @map("file_size")
  mimeType  String    @map("mime_type")
  authorId  String    @map("author_id")
  createdAt DateTime? @map("created_at")
  isPublic  Boolean?  @default(true) @map("is_public")
  ignore    Boolean?  @default(false)

  author    User            @relation(fields: [authorId], references: [id])
  @@index([authorId], map: "ix_audio_hosting_author_id")
  @@index([createdAt], map: "ix_audio_hosting_created_at")
  @@index([id], map: "ix_audio_hosting_id")
  @@index([ignore], map: "ix_audio_hosting_ignore")

  @@map("audio_hosting")
}

// ── 投票 ─────────────────────────────────────────────────────────────────────

model Vote {
  id        String    @id
  title     String
  authorId  String    @map("author_id")
