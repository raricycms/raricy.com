// ── 鱼干只读凭据（站外机器人 / 银行） ─────────────────────────────────────────
//
// 能查余额与流水，**不能转账**（见 prisma/migrations/15_fish_api_tokens 头部）。
// 与 oauth_access_tokens 形状同源但刻意分表，理由在那个迁移的头部。
// 明文只在签发那一次返回，库里只存 sha256；到期时间必填（本表不提供永不过期）。

model FishApiToken {
  id         Int       @id @default(autoincrement())
  tokenHash  String    @unique(map: "fish_api_tokens_token_hash_key") @map("token_hash")
  userId     String    @map("user_id")
  // 给用户自己认哪张凭据用（「对账机器人」「提现脚本」）。纯展示，不参与鉴权。
  label      String?
  // 空格分隔，跟 oauth_access_tokens 同款（SQLite 没有 enum 也没有数组）。
  // 当前只发 'read' —— 别加 write/transfer，理由见迁移头部。
  scopes     String    @default("read")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime? @map("created_at")

  user User @relation(fields: [userId], references: [id])
  @@index([userId], map: "ix_fish_api_tokens_user_id")
  @@index([expiresAt], map: "ix_fish_api_tokens_expires_at")

  @@map("fish_api_tokens")
}

// ── 鱼干收款回调（webhook） ───────────────────────────────────────────────────
//
// 用户级 1:1 的地址配置 + outbox 形式的投递记录。设计要点（尤其是「为什么
// payload 存成品」「sending 是租约」「at-least-once 所以接收方必须去重」）
// 全在 prisma/migrations/16_fish_webhooks 的头部，改动前先读那一份。

model FishWebhookEndpoint {
  userId              String    @id @map("user_id")
  url                 String
  /** Fernet 密文（同 User.fishApiKeyEncrypted）。签名密钥是凭证，不能明文落库。 */
  secretEncrypted     String    @map("secret_encrypted")
  disabledAt          DateTime? @map("disabled_at")
  /** 只用于展示，**不自动停用** —— 悄悄停掉全部回调是静默失效。 */
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastSuccessAt       DateTime? @map("last_success_at")
  lastFailureAt       DateTime? @map("last_failure_at")
  createdAt           DateTime? @map("created_at")
  updatedAt           DateTime? @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  @@map("fish_webhook_endpoints")
}

model FishWebhookDelivery {
  id             Int       @id @default(autoincrement())
  /** 接收方去重句柄；重试之间不变（随机，不是自增 id）。 */
  deliveryId     String    @unique(map: "fish_webhook_deliveries_delivery_id_key") @map("delivery_id")
  userId         String    @map("user_id")
  /** 共享单号：与转账两条流水上的同一个值，商户据此把回调对上那一笔。 */
  transferId     String    @map("transfer_id")
  event          String
  /** 序列化后的正文快照 —— 重试要字节稳定（签名算在它上面），不是重建参数。 */
  payload        String
  /** pending | sending | delivered | dead。**绝不物理删除**。 */
  status         String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @map("next_attempt_at")
  lastError      String?   @map("last_error")
  lastStatusCode Int?      @map("last_status_code")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime? @map("created_at")
  updatedAt      DateTime? @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  @@index([status, nextAttemptAt], map: "ix_fish_webhook_deliveries_due")
  @@index([userId], map: "ix_fish_webhook_deliveries_user_id")
  @@index([transferId], map: "ix_fish_webhook_deliveries_transfer_id")
  @@map("fish_webhook_deliveries")
}

// ── 鱼干练手盘（/fish/trade）─────────────────────────────────────────────────
//
// 一个用户投鱼干买入一个**绑定真实加密价格**的仓位，价格涨跌决定他能拿回多少鱼干。
// 系统账户是无限水池（只在远端存在），赚了从它 mint、亏了 burn 回它 —— 没有撮合、
// 没有对手盘、没有敞口。设计要点（尤其是「一行 = 一个批次」「为什么价格是 REAL
// 而鱼干金额是整数」「为什么流水列不建外键」）全在
// prisma/migrations/18_market_positions 的头部，改动前先读那一份。
model MarketPosition {
  id           String    @id
  userId       String    @map("user_id")
  /** 白名单见 src/lib/market-price.ts 的 MARKET_SYMBOLS。加币要同步页面文案。 */
  symbol       String
  /** 投入的鱼干，**存储单位 = 0.0001 鱼干**（同 User.driedFish）。 */
  stakeUnits   Int       @map("stake_units")
  /**
   * 开仓成交价。⚠️ 这是**价格**不是金额，REAL 是刻意的（理由见迁移头部）——
   * 它从不累加进账本，不参与 fish-units 换算，别「统一」成整数单位。
   */
  entryPrice   Float     @map("entry_price")
  /** 成交价的取价时刻（nowForDb()）—— 审计用：证明成交那一刻系统看到的价。 */
  entryQuoteAt DateTime  @map("entry_quote_at")
  /**
   * 杠杆倍数。1 = 无杠杆。白名单见 src/lib/market-service.ts 的 LEVERAGE_OPTIONS。
   * 存量行全是 1（这一列随迁移 23_market_leverage 加入）。
   */
  leverage     Int       @default(1)
  /**
   * 保证金归零的价 —— 归零即爆仓。**多头**公式：开仓价 × (1 − 1/杠杆)，
   * 唯一实现在 src/lib/market-math.ts 的 liquidationPrice()。
   * 1 倍时恒为 0，那正是「1 倍永不被强平」的字面意思（价格到不了 0 以下）。
   *
   * ⚠️ 与 entryPrice 同款：REAL 是刻意的，它不累加进账本、不参与 fish-units 换算。
   * ⚠️ **开仓那一刻算一次就写死**，之后没有任何人重算它。读它，别自己乘一遍
   *   （同 payout_units 的道理：有争议时以库里那一行写的数为准）。
   */
  liquidationPrice Float  @default(0) @map("liquidation_price")
  openTxId     Int?      @map("open_tx_id")
  /** 开仓幂等键（每次唯一，带随机后缀）。唯一约束就是幂等的实现。 */
  openKey      String    @unique(map: "market_positions_open_key_key") @map("open_key")
  /** open | closed | liquidated（爆仓，由强平引擎写，见 src/lib/market-liquidator.ts）。
   *  后两者都是终态：`status !== 'open'` 即「已结清」。
   *  **绝不物理删除**，没有例外（曾有一处：远端同步失败的补偿事务会删掉从未生效的
   *  开仓，那个机制随账户服务搬进站内一起消失了）。 */
  status       String    @default("open")
  exitPrice    Float?    @map("exit_price")
  exitQuoteAt  DateTime? @map("exit_quote_at")
  /** 结算那一刻算出来的实发单位数，**不是事后重算的** —— 有争议时以它为准。 */
  payoutUnits  Int?      @map("payout_units")
  closeTxId    Int?      @map("close_tx_id")
  closedAt     DateTime? @map("closed_at")
  createdAt    DateTime? @map("created_at")

  user User @relation(fields: [userId], references: [id])
  @@index([userId, status], map: "ix_market_positions_user_status")
  @@map("market_positions")
}

// ── 管理审计 ─────────────────────────────────────────────────────────────────

