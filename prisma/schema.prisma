// ── OAuth 2.0（外部应用身份绑定） ────────────────────────────────────────────
// 仅用于「让第三方应用代表已登录用户读取基础资料」。v1 不发 write scope，
// 因此 OAuthAccessToken 仅出现在读路径；refresh_token 不在 v1 范围内。
//
// 应用注册由 owner 经 CLI（npm run cli -- oauth create-app）或 /admin/oauth 完成；
// 客户端鉴权走 client_id + client_secret（werkzeug 兼容 scrypt 哈希入库）；
// 授权码 / access_token 不透明随机串，仅存 SHA-256 哈希作为 PK。

model OAuthApplication {
  id               String    @id
  clientId         String    @unique @map("client_id")
  clientSecretHash String    @map("client_secret_hash")
  name             String
  description      String?
  homepageUrl      String?   @map("homepage_url")
  // SQLite 无数组类型 → JSON 字符串（应用层 parse）。结构：["https://app.example.com/cb","..."]
  redirectUris     String    @map("redirect_uris")
  createdById      String    @map("created_by_id")
  createdAt        DateTime? @map("created_at")
  disabledAt       DateTime? @map("disabled_at")

  createdBy         User                      @relation("OAuthAppOwner", fields: [createdById], references: [id])
  authorizationCodes OAuthAuthorizationCode[]
  accessTokens       OAuthAccessToken[]

  @@index([clientId], map: "ix_oauth_apps_client_id")
  @@index([createdById], map: "ix_oauth_apps_created_by_id")
  @@map("oauth_applications")
}

model OAuthAuthorizationCode {
  // 主键 = SHA-256(明文)，64 字符 hex。原始 code 仅在 /api/oauth/authorize 响应里出现一次。
  codeHash      String    @id @map("code_hash")
  applicationId String    @map("application_id")
  userId        String    @map("user_id")
  redirectUri   String    @map("redirect_uri")
  // 空格分隔的 scope 串（当前只有 "profile"）。⚠️ **不是 JSON** —— 同一张表里
  // redirect_uris 才是 JSON。编解码见 src/lib/oauth.ts 的 scopesToString / normalizeScopes。
  scopes        String
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime? @map("created_at")

  application OAuthApplication @relation(fields: [applicationId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@index([applicationId, userId], map: "ix_oauth_codes_app_user")
  @@index([expiresAt], map: "ix_oauth_codes_expires_at")
  @@map("oauth_authorization_codes")
}

// ── 幂等记录（曾经的「账户微服务同步账本」）───────────────────────────────
// 【表名与列名是历史，不要再按字面理解】这张表当年是 outbox：本地事务先提交
// （登记一行 pending）→ 事务外调站外的账户微服务 → 成功标 synced / 失败走补偿事务。
// 那套机制随账户服务搬进站内一起消失了 —— 账目与业务数据现在在同一个 SQLite
// 事务里，要么都成要么都不成，没有中间态可收敛。
// 表**刻意保留原名**（见 docs/legacy-constraints.md）：里面有真的历史账，改名的迁移
// 收益不抵风险。**语义与用法以 src/lib/fish-idempotency.ts 为准**：
//   · 现在写入的行**一律 status='synced'**（登记与业务写入同事务提交，提交成功即已生效）；
//   · 只有**键是确定的**操作才登记（转账带客户端幂等键、群发补偿按 batchId 派生）；
//     随机后缀键的操作不写行 —— 判据与理由在 fish-idempotency.ts 头部。
// 存量里可能残留 status != 'synced' 的行：那是迁移前的遗留，读的时候要当成
// 「不确定」处理（见 fish-market-service.resolveDuplicate），别当它不存在。
model AccountSyncLedger {
  id             Int       @id @default(autoincrement())
  // 幂等键。历史上是发往账户服务的 Idempotency-Key，现在只在本站内唯一。
  idempotencyKey String    @unique @map("idempotency_key")
  // 迁移前的值：feed | checkin | admin_grant | admin_deduct | compensate | register |
  // transfer | market_buy | market_sell。现在只写入 transfer 与 compensate。
  operation      String
  // JSON 字符串：发起这笔操作时的非敏感参数（SQLite 无数组/Json 标量）。
  // 【纪律不变】密钥类字段（系统 Key / 用户 Key）一律不入库。
  payload        String
  // 新写入一律 'synced'。历史值：pending / synced / compensated / failed。
  status         String    @default("pending")
  // 仅历史行有意义（迁移前的重放尝试次数）。新写入恒为 0。
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  createdAt      DateTime? @map("created_at")
  updatedAt      DateTime? @map("updated_at")

  @@index([status], map: "ix_account_sync_ledger_status")
  @@index([createdAt], map: "ix_account_sync_ledger_created_at")
  @@map("account_sync_ledger")
}

model OAuthAccessToken {
  // 主键 = SHA-256(明文)，64 字符 hex。
  tokenHash     String    @id @map("token_hash")
  applicationId String    @map("application_id")
  userId        String    @map("user_id")
  scopes        String
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  lastUsedAt    DateTime? @map("last_used_at")
  createdAt     DateTime? @map("created_at")

  application OAuthApplication @relation(fields: [applicationId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@index([applicationId, userId], map: "ix_oauth_tokens_app_user")
  @@index([userId], map: "ix_oauth_tokens_user_id")
  @@index([expiresAt], map: "ix_oauth_tokens_expires_at")
  @@map("oauth_access_tokens")
}

// ── 在线讨论区（见 migration 4_chat / src/lib/chat-service.ts） ───────────────
// 频道（大区 + 私聊）→ 成员（含读游标，用于未读）→ 消息（自增 id 作增量游标）。
// 注意：image_id / reply_to 不在此库建外键（图床硬删 / 消息软删都不应被物理约束卡住），
// 外键关系只在 Prisma 层表达（测试库 prisma db push 会建约束，生产走手写 migration.sql）。

model ChatChannel {
  id        String        @id
  // 'lobby'（固定 id='lobby'，全局大区）| 'direct'（私聊，仅两成员）
  kind      String        @default("direct")
  createdAt DateTime?     @map("created_at")

  members  ChatMember[]
  messages ChatMessage[]

  @@map("chat_channels")
}

model ChatMember {
  id                Int       @id @default(autoincrement())
  channelId         String    @map("channel_id")
  userId            String    @map("user_id")
  // 读游标：未读数 = 频道内 id > 该值且未软删的消息数
  lastReadMessageId Int       @default(0) @map("last_read_message_id")
  // 静音：非空即该会话不产生通知（未读徽标照常显示）
  mutedAt           DateTime? @map("muted_at")
  // 会话隐藏：隐藏时记下「当时的频道最大消息 id」；之后有新消息（id 更大）就重新出现
  hiddenAfterMessageId Int?   @map("hidden_after_message_id")
  createdAt         DateTime? @map("created_at")

  channel ChatChannel @relation(fields: [channelId], references: [id])
  user    User        @relation("ChatMemberUser", fields: [userId], references: [id])

  @@unique([channelId, userId], name: "uq_chat_member_channel_user")
  @@index([userId], map: "ix_chat_members_user_id")
  @@map("chat_members")
}

model ChatMessage {
  id         Int       @id @default(autoincrement())
  channelId  String    @map("channel_id")
  authorId   String    @map("author_id")
  // 正文为 Markdown 源文（客户端经 chat-markdown.ts 白名单净化后渲染，见 ChatMarkdown）；
  // 带图 / 引用博客时此处放可选图注
  content    String    @default("")
  // 引用的图床图片（上传走 /api/images，消息只存引用）
  imageId    String?   @map("image_id")
  // 引用回复的消息 id（须同频道且未软删）
  replyTo    Int?      @map("reply_to")
  // 引用博客的 UUID（blogs.id；无 relation —— 同 image_id 策略：博客软删不挡讨论，
  // 渲染期由 chat-service 按当前 Blog 行解析，软删后给 [博客已删除] 占位）
  blogId     String?   @map("blog_id")
  // 拍一拍的目标用户 id（无 relation —— 同上策略：username 读时解析、不存快照）。
  // 非空即「拍一拍」消息：正文/图片/引用博客一律为空，前端渲染为居中灰字系统行。
  patTargetId String?  @map("pat_target_id")
  isDeleted  Boolean?  @default(false) @map("is_deleted")
  createdAt  DateTime? @map("created_at")

  channel    ChatChannel  @relation(fields: [channelId], references: [id])
  author     User         @relation("ChatMessageAuthor", fields: [authorId], references: [id])
  image      ImageHosting? @relation(fields: [imageId], references: [id])
  replyToMsg ChatMessage?  @relation("ChatMessageReply", fields: [replyTo], references: [id])
  replies    ChatMessage[] @relation("ChatMessageReply")

  @@index([channelId, id], map: "ix_chat_messages_channel_id_id")
  @@map("chat_messages")
}

// ── 收藏夹 ───────────────────────────────────────────────────────────────────

// 用户自建的博客收藏夹。软删（deleted/deletedAt），永不物理删。
//
// ⚠️ id 是 **UUID**，不是自增整数 —— 这不是随手选的：
//   • 私密收藏夹按需求**没有**可分享的 6 位 id（publicId 为 NULL），所以所有者的
//     管理页只能拿内部 id 当路由参数（/favorite/mine/<id>）。自增整数是**顺序可枚举**
//     的，那样「私密收藏夹没有对外把手」就只靠每条路由都记得判所有权来兜底；
//     UUID 让「某条路由忘了判」从「越权读到别人的私密收藏夹」降级成无害。
//   • 与 §8 的 ID 口径一致：UUID4 用于 User / Blog / Comment 这类用户内容。
//
// ⚠️ publicId 非空 ⟺ isPublic 为真（见 src/lib/favorite-service.ts 的「不变量 1」）。
//   私密收藏夹的 public_id 恒为 NULL —— 不是「有 id 但不显示」。SQLite 的 UNIQUE
//   允许任意多个 NULL，所以私密行永远不可能意外获得把手。
//   ⚠️ 反向不成立：**绝不**用 `public_id != NULL` 代替 `is_public = 1` 来判公开
//   （历史行 / 未来的写路径都可能留下「is_public=0 但 public_id 还在」的活口）。
model Favorite {
  id        String    @id
  /// 6 位数字的对外把手，**仅公开收藏夹有值**。全程按字符串处理（"000123" 不能被数字化）。
  publicId  String?   @unique(map: "ix_favorites_public_id") @map("public_id")
  userId    String    @map("user_id")
  title     String
  /// 创建时定，**此后不可修改**（没有任何接口能改它；改性质只能靠「复制」）。
  isPublic  Boolean   @default(false) @map("is_public")
  createdAt DateTime? @map("created_at")
  deleted   Boolean   @default(false)
  deletedAt DateTime? @map("deleted_at")

  user  User           @relation(fields: [userId], references: [id])
  items FavoriteItem[]

  @@index([userId], map: "ix_favorites_user_id")
  @@map("favorites")
}

// 收藏夹条目。形态刻意对齐 BlogLike（非可选 deleted + 配对 deletedAt + 命名唯一约束）：
// 同一个博客可以被同一个用户放进**多个**收藏夹，所以唯一的粒度是 (收藏夹, 博客)，
// 而不是 (用户, 博客)。
//
// ⚠️ 唯一约束是**物理**的、包含墓碑行，因此「移出后再加入」必须**复活旧行**
//   （翻转 deleted），不能新插一行 —— 会撞唯一约束。见 favorite-service 的「不变量 8」。
model FavoriteItem {
  id         Int       @id @default(autoincrement())
  favoriteId String    @map("favorite_id")
  blogId     String    @map("blog_id")
  createdAt  DateTime? @map("created_at")
  deleted    Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")

  favorite Favorite @relation(fields: [favoriteId], references: [id])
  blog     Blog     @relation(fields: [blogId], references: [id])

  @@unique([favoriteId, blogId], name: "uq_favorite_item")
  @@index([favoriteId], map: "ix_favorite_items_favorite_id")
  @@index([blogId], map: "ix_favorite_items_blog_id")
  @@map("favorite_items")
}

// ── 头像框 ───────────────────────────────────────────────────────────────────

/// 用户持有的头像框（**所有权账**）。
///
/// 【两层，别混】持有（本表）与装备（users 上那两个冗余列）是两层：
///   · 持有 = 「我有没有资格戴」—— 发放是站长的事（`npm run cli -- frame grant`），
///     第二版会加上鱼干购买
///   · 装备 = 「我现在戴哪个」—— 用户自己的事（/settings 的面板）
/// 一个用户可以同时持有多个框、只戴一个；也可以持有一个却不戴。
///
/// 【框的**定义**不在这里】key / 显示名 / 排序住在代码白名单
///   src/lib/frame-refs.ts 的 FRAME_KEYS（照 src/lib/market-price.ts 的 MARKET_SYMBOLS
///   先例：不建定义表、不做后台 CRUD）。素材字节在 instance/frames/<key>.png。
///   所以本表的 frame_key 是**文本而非外键**，且**加了新框不需要迁移**。
///
/// 【expires_at 是「到期」不是「撤销」】过期后行照旧 alive（deleted 仍为 false）——
///   全站不物删。判定在 src/lib/frame-service.ts 的 frameUrlFor()，那是唯一出口。
///
/// 【形态对齐 FavoriteItem】自增 id（join 行口径）+ 非可选 deleted + 配对 deletedAt +
///   命名唯一约束 + createdAt 无 @default（写路径必须显式 nowForDb()）。
///   ⚠️ 唯一约束是**物理**的、包含墓碑行，因此「收回后再授予」必须**复活旧行**
///   （翻转 deleted），不能新插 —— 会撞唯一约束。见 frame-service 的不变量 F4。
model UserFrame {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id")
  /// 白名单 key，见 src/lib/frame-refs.ts 的 FRAME_KEYS。**刻意不是外键**（见上）。
  frameKey  String    @map("frame_key")
  /// NULL = 永久。
  expiresAt DateTime? @map("expires_at")
  /// 发放来源：'cli'（站长用运维台发）/ 'purchase'（第二版鱼干购买）/ 'system'。
  /// 【为什么留这一列】不留的话「站长发的」与「买的」永远分不出来，而那段历史
  /// 补不回来（同 blog_visibility_logs.actor_id 的理由）。一列 TEXT 换这个，划算。
  source    String    @default("cli")
  createdAt DateTime? @map("created_at")
  deleted   Boolean   @default(false)
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  // ⚠️ 这里的 name 只影响 Prisma Client 的 API 名（upsert 时用它当 where 的键）。
  // SQLite 上 Prisma **忽略**它来建物理索引，一律用派生名
  // "user_frames_user_id_frame_key_key" —— 所以 migrations/20_user_frames 里写的是
  // 派生名，两者**不是**不一致。别照着这个名字去改迁移（改了就与 db push 漂移）。
  @@unique([userId, frameKey], name: "uq_user_frame")
  @@index([userId], map: "ix_user_frames_user_id")
  @@map("user_frames")
}
