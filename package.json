{
  "name": "raricy.com",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true,
  "description": "raricy.com (聪明山) — Next.js + Prisma + SQLite. 单进程部署，自有 instance/ 数据目录。",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && node scripts/copy-converter-assets.mjs && next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "next lint",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "db:normalize": "node scripts/normalize-datetimes.mjs --source ./instance/database/db.db --dest ./instance/database/dev.db",
    "migrate": "node scripts/migrate.mjs",
    "diagnose": "tsx scripts/diagnose-deploy.mjs",
    "probe:ws": "node scripts/probe-binance-ws.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cli": "tsx scripts/cli.ts",
    "e2e": "playwright test",
    "e2e:ci": "npm run build && playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare:cutover": "tsx scripts/prepare-cutover.mjs",
    "smoke": "tsx scripts/smoke.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "instance:check": "node scripts/check-instance.mjs",
    "css:probe": "sass src/styles-scss/main.scss:src/styles-scss/compiled/probe.css --style=expanded --load-path=src/styles-scss --no-source-map",
    "prepare:mathjax": "node scripts/copy-mathjax-fonts.mjs",
    "mathjax:check": "node scripts/copy-mathjax-fonts.mjs --check",
    "prepare:emoji": "node scripts/copy-emoji-assets.mjs",
    "emoji:check": "node scripts/copy-emoji-assets.mjs --check",
    "prepare:converter": "node scripts/copy-converter-assets.mjs",
    "converter:check": "node scripts/copy-converter-assets.mjs --check",
    "postinstall": "node scripts/copy-mathjax-fonts.mjs && node scripts/copy-emoji-assets.mjs && node scripts/copy-converter-assets.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@lezer/highlight": "1.2.5",
    "@prisma/client": "^6.2.1",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@twemoji/svg": "^15.0.0",
    "7z-wasm": "1.2.0",
    "docx": "9.9.0",
    "dompurify": "^3.4.12",
    "fast-xml-parser": "4.5.3",
    "fernet": "^0.3.3",
    "fflate": "0.8.2",
    "heic2any": "0.0.4",
    "highlight.js": "^11.11.1",
    "iconv-lite": "0.6.3",
    "jose": "^5.9.6",
    "js-yaml": "4.1.0",
    "lucide-react": "^1.42.0",
    "mammoth": "1.13.0",
    "marked": "^18.0.6",
    "mathjax-full": "^3.2.2",
    "next": "^15.1.4",
    "node-unrar-js": "2.0.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "pptxgenjs": "4.0.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "tesseract.js": "5.1.1",
    "utif": "3.1.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@playwright/test": "^1.61.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "jsqr": "^1.4.0",
    "prisma": "^6.2.1",
    "sass": "^1.99.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
