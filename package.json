{
  "name": "raricy.com",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "description": "raricy.com (聪明山) — Next.js + Prisma + SQLite，共同启动的实时游戏进程，自有 instance/ 数据目录。",
  "scripts": {
    "dev": "node scripts/start.mjs dev",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs start",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "db:normalize": "node scripts/normalize-datetimes.mjs --source ./instance/database/db.db --dest ./instance/database/dev.db",
    "migrate": "node scripts/migrate.mjs",
    "schema:diff": "node scripts/schema-diff.mjs",
    "diagnose": "tsx scripts/diagnose-deploy.mjs",
    "probe:ws": "node scripts/probe-binance-ws.mjs",
    "check:links": "node scripts/check-links.mjs",
    "reactive:corpus": "node --experimental-sqlite node_modules/vite-node/vite-node.mjs --config vitest.config.ts scripts/reactive-corpus-report.mjs",
    "reactive:migrate-v07": "vite-node --config scripts/reactive-vite.config.ts scripts/reactive-migrate-v07.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:related": "vitest related --run",
    "cli": "tsx scripts/cli.ts",
    "e2e": "playwright test",
    "e2e:ci": "npm run build && playwright test",
    "e2e:ui": "playwright test --ui",
    "probe:page": "tsx scripts/probe-page.mjs",
    "prepare:cutover": "tsx scripts/prepare-cutover.mjs",
    "smoke": "tsx scripts/smoke.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "instance:check": "node scripts/check-instance.mjs",
    "css:probe": "sass src/styles-scss/main.scss:src/styles-scss/compiled/probe.css --style=expanded --load-path=src/styles-scss --no-source-map",
    "prepare:emoji": "node scripts/copy-emoji-assets.mjs",
    "emoji:check": "node scripts/copy-emoji-assets.mjs --check",
    "prepare:converter": "node scripts/copy-converter-assets.mjs",
    "converter:check": "node scripts/copy-converter-assets.mjs --check",
    "pwa:icons:check": "node scripts/make-pwa-icons.mjs --check",
    "fonts:check": "node scripts/check-font-assets.mjs",
    "fonts:check:regen": "python scripts/make-numeric-fonts.py --check",
    "postinstall": "node scripts/copy-emoji-assets.mjs && node scripts/copy-converter-assets.mjs",
    "realtime:build": "tsc -p services/realtime/tsconfig.json",
    "search:rebuild": "vite-node --config scripts/reactive-vite.config.ts scripts/rebuild-public-search.mts",
    "search:benchmark": "vite-node --config scripts/reactive-vite.config.ts scripts/benchmark-public-search.mts",
    "reactive:measure": "vite-node --config vitest.config.ts scripts/reactive-budget-measure.mts",
    "acceptance:seed": "vite-node --config vitest.config.ts scripts/seed-acceptance.mts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@lezer/highlight": "1.2.5",
    "@prisma/client": "^6.2.1",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@twemoji/svg": "^15.0.0",
    "7z-wasm": "1.2.0",
    "docx": "9.9.0",
    "dompurify": "^3.4.12",
    "fast-xml-parser": "4.5.3",
    "fernet": "^0.3.3",
    "fflate": "0.8.2",
    "heic2any": "0.0.4",
    "iconv-lite": "0.6.3",
    "jose": "^5.9.6",
    "js-yaml": "4.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.42.0",
    "mammoth": "1.13.0",
    "marked": "^18.0.6",
    "next": "^15.5.27",
    "node-unrar-js": "2.0.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "pptxgenjs": "4.0.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reactive-md": "file:vendor/reactive-md-0.8.0-next.0-be1fadd-next15.tgz",
    "sharp": "^0.35.3",
    "tesseract.js": "5.1.1",
    "utif": "3.1.0",
    "ws": "8.22.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@playwright/test": "^1.61.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "prisma": "^6.2.1",
    "sass": "^1.99.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
