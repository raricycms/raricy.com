{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "../..",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "src/quandi-engine/**/*.js", "../../shared/**/*.ts"],
  "exclude": ["dist"]
}
