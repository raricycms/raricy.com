/node_modules
/.next
/out
next-env.d.ts
# 环境变量：真实密钥只存在于 .env*，绝不入库。
# 只写 `.env` 不够 —— `.env.production` / `.env.local` 不匹配该模式，
# 而 docs/deploy.md 恰恰让人创建 .env.production 放 SECRET_KEY，
# 一次 `git add .` 就会把它推上远端（git 不会忘）。模板文件用 ! 显式放行。
.env
.env.*
!.env.example
!.env.production.example
*.tsbuildinfo
# 本地 SQLite 副本（含真实用户数据，绝不入库）
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# 测试临时数据库
tests/.tmp/
coverage/

# Playwright E2E 产物
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# 运行时数据目录（头像 / 图床 / 故事 / 数据库）—— 绝不入库
#
# 头像框素材**不在**这里：它是我们自己画的（源码 = scripts/make-frame-demos.mjs），
# 与第三方素材那条红线无关，所以住 public/static/frames/ 并随代码入库。
/instance/

# instance 的本地打包归档（app.db + stories 等真实数据，备份用）—— 不入库
/instance.zip

# vditor 的 icon sprite + KaTeX 静态资源 —— 从 npm 包拷贝，
# 不要直接入库（保持 /public/static/vditor/ 由 `npm run prepare:vditor` 重建）
/public/static/vditor/

# MathJax CHTML 的 woff 字体 —— 同上，从 mathjax-full 拷贝，
# 由 `npm run prepare:mathjax` 重建（MarkdownRenderer 的 fontURL 指向这里）
/public/static/mathjax/

# 内置「黄脸表情」的 SVG —— 同上，从 @twemoji/svg 按 src/lib/emoji-faces.json
# 挑着拷贝，由 `npm run prepare:emoji` 重建。素材是 Twemoji（CC BY 4.0，需署名），
# 复制脚本会连 LICENSE.txt 一起生成。
/public/static/emoji/

# SCSS 的编译产物 —— 全站样式由 src/app/layout.tsx 直接 import 入口
# src/styles-scss/main.scss，交给 Next 自己编译（dev 走 HMR，build 走 sass-loader），
# 产物既没人生成也没人读，自然不该入库。
# 注意：`npm run css:probe` 仍在，但它只是**离线调试**用（tests/.tmp/ 下的手工
# 像素探针 HTML 靠它拿样式），不参与任何构建或测试流程 —— 名字里刻意不带 build:，
# 免得有人以为构建需要它。
/src/styles-scss/compiled/

# 数据库文章的本地导出（数千个 md + 一份 db 副本，含真实用户数据）—— 不入库
/blog-export/
