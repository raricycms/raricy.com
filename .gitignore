/node_modules
/.next
/out
next-env.d.ts
# 环境变量：真实密钥只存在于 .env*，绝不入库。
# 只写 `.env` 不够 —— `.env.production` / `.env.local` 不匹配该模式，
# 而 docs/deploy.md 恰恰让人创建 .env.production 放 SECRET_KEY，
# 一次 `git add .` 就会把它推上远端（git 不会忘）。模板文件用 ! 显式放行。
.env
.env.*
!.env.example
!.env.production.example
*.tsbuildinfo
# 本地 SQLite 副本（含真实用户数据，绝不入库）
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# 测试临时数据库
tests/.tmp/
coverage/

# Playwright E2E 产物
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# 运行时数据目录（头像 / 图床 / 故事 / 数据库）—— 绝不入库
/instance/

# instance 的本地打包归档（app.db + stories 等真实数据，备份用）—— 不入库
/instance.zip

# vditor 的 icon sprite + KaTeX 静态资源 —— 从 npm 包拷贝，
# 不要直接入库（保持 /public/static/vditor/ 由 `npm run prepare:vditor` 重建）
/public/static/vditor/

# MathJax CHTML 的 woff 字体 —— 同上，从 mathjax-full 拷贝，
# 由 `npm run prepare:mathjax` 重建（MarkdownRenderer 的 fontURL 指向这里）
/public/static/mathjax/

# Python 副产物（历史迁移文档里的代码示例等可能产生）
__pycache__/
*.pyc
